<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces the old windowBackground splash with the system
         splash screen. windowSplashScreenAnimatedIcon must resolve to an
         AdaptiveIconDrawable, otherwise the platform falls back to the
         clipped launcher icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_page</item>
    </style>
</resources>
